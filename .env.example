# =============================================================================
# AI HealthAssist — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# -----------------------------------------------------------------------------
# AI Provider
# -----------------------------------------------------------------------------
# AI_PROVIDER=gemini   → Use Google Gemini (default, recommended)
# AI_PROVIDER=watsonx  → Use IBM watsonx.ai (requires IBM credentials below)
AI_PROVIDER=gemini

# -----------------------------------------------------------------------------
# Google Gemini credentials (required when AI_PROVIDER=gemini)
# -----------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use (current recommended default)
# Other available models: gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.7-flash
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# IBM watsonx.ai credentials (only required when AI_PROVIDER=watsonx)
# -----------------------------------------------------------------------------
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM model configuration (only used when AI_PROVIDER=watsonx)
# Supported: meta-llama/llama-3-8b-instruct, ibm/granite-13b-instruct-v2,
#            meta-llama/llama-3-70b-instruct
WATSONX_MODEL_ID=meta-llama/llama-3-8b-instruct

# -----------------------------------------------------------------------------
# Flask configuration
# -----------------------------------------------------------------------------
FLASK_DEBUG=false
